layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_depth;
// Light scattering has no alpha and is never negative
#ifdef SHADER_STORAGE_IMAGE_EXTENDED_FORMATS
layout(set = 0, binding = 1, r11f_g11f_b10f) uniform writeonly image2D u_scatter;
#else
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_scatter;
#endif

layout(push_constant) uniform PushConstants
{
    // x0, y0, x1, y1 (exclusive) in pixels of the depth: the viewport of one
    // camera, u_scatter is half the size of it and covers the same area
    ivec4 m_rect;
} pc;

#include "utils/camera.glsl"
#include "utils/global_light_data.glsl"
#include "utils/unproject_position.glsl"

// Light scattering of the point lights in the fog: every pixel marches in 16
// steps from the farthest point of its ray inside the sphere of the light (or
// the geometry, whichever is closer) back to the camera. The result is blurred
// (light_scatter_blur.comp) and added to hdr (lighting_composite.frag).
//
// Here every tile of 16x16 pixels first collects the lights which touch its
// view frustum (like the billboards do, but with the exact sphere), so most of
// the pixels loop over few lights or none.
const int STEPS = 16;
const uint TILE_THREADS = 64u;

shared uint s_count;
shared uint s_index[MAX_RENDERING_LIGHT];
// View space position (xyz) and radius (w)
shared vec4 s_light[MAX_RENDERING_LIGHT];

void main()
{
    const ivec2 dst_min = pc.m_rect.xy >> 1;
    const ivec2 dst_max = (pc.m_rect.zw + 1) >> 1;
    const ivec2 dst = dst_min + ivec2(gl_GlobalInvocationID.xy);
    const bool inside = all(lessThan(dst, dst_max));
    const uint thread = gl_LocalInvocationIndex;
    const uint light_count = uint(max(u_global_light.m_light_count, 0));

    // View frustum of the tile (apex at the camera), the 4 corners are
    // projected at the near plane
    ivec2 tile_min = dst_min * 2 + ivec2(gl_WorkGroupID.xy) * 16;
    ivec2 tile_max = min(tile_min + 16, pc.m_rect.zw);
    vec3 corners[4];
    corners[0] = getPosFromUVDepth(vec3(vec2(tile_min), 1.0),
        u_camera.m_viewport, u_camera.m_inverse_projection_matrix);
    corners[1] = getPosFromUVDepth(vec3(tile_max.x, tile_min.y, 1.0),
        u_camera.m_viewport, u_camera.m_inverse_projection_matrix);
    corners[2] = getPosFromUVDepth(vec3(vec2(tile_max), 1.0),
        u_camera.m_viewport, u_camera.m_inverse_projection_matrix);
    corners[3] = getPosFromUVDepth(vec3(tile_min.x, tile_max.y, 1.0),
        u_camera.m_viewport, u_camera.m_inverse_projection_matrix);
    vec3 middle = corners[0] + corners[1] + corners[2] + corners[3];
    vec3 planes[4];
    for (int i = 0; i < 4; i++)
    {
        vec3 n = normalize(cross(corners[i], corners[(i + 1) & 3]));
        // Pointing inside of the frustum
        planes[i] = dot(n, middle) < 0.0 ? -n : n;
    }

    if (thread == 0u)
        s_count = 0u;
    barrier();
    for (uint i = thread; i < light_count; i += TILE_THREADS)
    {
        float radius = u_global_light.m_lights[i].m_position_radius.w;
        vec3 light_pos = (u_camera.m_view_matrix *
            vec4(u_global_light.m_lights[i].m_position_radius.xyz, 1.0)).xyz;
        bool touch = true;
        for (int j = 0; j < 4; j++)
            touch = touch && dot(planes[j], light_pos) >= -radius;
        if (touch)
        {
            uint slot = atomicAdd(s_count, 1u);
            s_index[slot] = i;
            s_light[slot] = vec4(light_pos, radius);
        }
    }
    barrier();

    if (!inside)
        return;
    const uint count = s_count;
    if (count == 0u)
    {
        imageStore(u_scatter, dst, vec4(0.0));
        return;
    }

    // The depth of the pixel at the bottom right of the 2x2 block
    ivec2 full = clamp(dst * 2 + 1, pc.m_rect.xy, pc.m_rect.zw - 1);
    float depth = texelFetch(u_depth, full, 0).x;

    // Reverse depth: 0 is the far plane (nothing is drawn, the sky) which is
    // at infinity, use the near plane only for the direction of the ray
    vec3 pixel_pos = getPosFromUVDepth(
        vec3(vec2(full) + 0.5, depth > 0.0 ? depth : 1.0), u_camera.m_viewport,
        u_camera.m_inverse_projection_matrix);
    vec3 ray_dir = normalize(pixel_pos);
    float scene_distance = depth > 0.0 ? length(pixel_pos) : 1.0e30;

    const float density = u_global_light.m_fog_density;
    vec3 scatter = vec3(0.0);
    for (uint n = 0u; n < count; n++)
    {
        vec3 light_pos = s_light[n].xyz;
        float radius = s_light[n].w;
        float along = dot(ray_dir, light_pos);
        // The ray never gets inside the sphere of the light
        if (along + radius <= 0.0 ||
            dot(light_pos, light_pos) - along * along >= radius * radius)
            continue;

        float farthest = min(along + radius, scene_distance);
        float closest = along - radius;
        // Start from the camera if the closest point is almost at it
        if (closest * ray_dir.z < 1.0)
            closest = 0.0;
        float step_size = (farthest - closest) / float(STEPS);
        // The light is behind the geometry
        if (step_size <= 0.0)
            continue;

        uint light_idx = s_index[n];
        vec3 fog_factor = u_global_light.m_lights[light_idx]
            .m_color_inverse_square_range.xyz * density * step_size * 20.0;

        // Spotlight direction calculation
        float sscale = u_global_light.m_lights[light_idx]
            .m_direction_scale_offset.z;
        vec3 sdir = vec3(0.0);
        if (sscale != 0.0)
        {
            sdir = vec3(u_global_light.m_lights[light_idx]
                .m_direction_scale_offset.xy, 0.0);
            sdir.z = sqrt(1.0 - dot(sdir, sdir)) * sign(sscale);
            sdir = (u_camera.m_view_matrix * vec4(sdir, 0.0)).xyz;
        }

        for (int j = 0; j < STEPS; j++)
        {
            vec3 xpos = ray_dir * (farthest - float(j) * step_size);
            vec3 light_to_pos = light_pos - xpos;
            float d = length(light_to_pos);
            float l = float(STEPS - j) * step_size;
            vec3 base_att = fog_factor / (1.0 + d * d) *
                max((radius - d) / radius, 0.0) * exp(-density * (d + l));

            // Apply spotlight attenuation
            if (sscale != 0.0)
            {
                float sattenuation = clamp(dot(-sdir, normalize(light_to_pos)) *
                    abs(sscale) + u_global_light.m_lights[light_idx]
                    .m_direction_scale_offset.w, 0.0, 1.0);
                base_att *= sattenuation * sattenuation;
            }
            scatter += base_att;
        }
    }
    imageStore(u_scatter, dst, vec4(scatter, 0.0));
}
