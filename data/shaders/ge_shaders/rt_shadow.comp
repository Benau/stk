// Ray traced shadow of the sun, the point lights and the spot lights
// (GEVulkanRTShadow), between the g-buffer and the lighting pass: the
// visibility (1.0 is lit) of every pixel of the viewport of a camera, which the
// lighting pass (deferred_pbr.frag and deferred_pointlight.frag) uses instead
// of the shadow map. The ray goes from the surface to the sun or the light in
// the ray traced scene (getSunShadow and getLightShadow of utils/rt_scene.glsl,
// the first is the same as the one of the hits of the reflection), so it has no
// range of a cascade, and a shadow of a node of the scene (karts, items, plants
// if they're in it) like the other ray traced effects.
//
// Layer 0 of the output is the sun, the other layers are the point lights and
// the spot lights (see utils/rt_shadow_layer.glsl), every layer is the z of a
// thread.
//
// Set 0 is the one of GEVulkanRTScene, set 1 the camera and the global light,
// set 2 the depth and the normal of the g-buffer and the output, and set 3 the
// mesh textures (of the alpha tested geometries)
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define MESH_TEXTURES_SET 3

// Visibility (x) and linear depth (y), see utils/rt_shadow_filter.glsl
#ifdef SHADER_STORAGE_IMAGE_EXTENDED_FORMATS
#define RT_SHADOW_FORMAT rg16f
#else
#define RT_SHADOW_FORMAT rg32f
#endif

layout(set = 2, binding = 0) uniform sampler2D u_depth;
layout(set = 2, binding = 1) uniform sampler2D u_normal;
layout(set = 2, binding = 2, RT_SHADOW_FORMAT) uniform writeonly image2DArray u_out;

layout(push_constant) uniform PushConstants
{
    // x0, y0, x1, y1 (exclusive) in texels of the output: the texels of the
    // viewport of one camera (rtShadowTexelRect)
    ivec4 m_rect;
    // Size of the output relative to the g-buffer
    float m_scale;
    // Bits of GEShadowType which are traced (the sun, the lights)
    int m_types;
    // Number of layers of lights (the layers after the sun)
    int m_lights;
} pc;

#include "utils/camera.glsl"
#include "utils/constants_utils.glsl"
#include "utils/unproject_position.glsl"
#include "../utils/decodeNormal.frag"
#include "utils/get_vertex_color.glsl"
#include "utils/sample_mesh_texture.glsl"
#include "utils/global_light_data.glsl"
#include "utils/rt_shadow_grid.glsl"
#include "utils/rt_utils.glsl"
#include "utils/rt_scene.glsl"
#include "utils/rt_shadow_layer.glsl"

void main()
{
    const int layer = rtShadowLayer();
    if (!rtShadowLayerActive(layer, u_global_light.m_light_count))
        return;
    const ivec2 texel = pc.m_rect.xy + ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, pc.m_rect.zw)))
        return;
    // The pixel of the g-buffer of the texel, it's in the viewport
    const ivec2 pixel = rtShadowTapPixel(texel, pc.m_scale,
        rtShadowPixelRect(u_camera.m_viewport, textureSize(u_depth, 0)));

    float visibility = 1.0;
    // Distance along the view direction of the surface, 0 is the sky
    float linear_depth = 0.0;
    const float depth = texelFetch(u_depth, pixel, 0).x;
    // Reverse z, 0 is the sky
    if (depth != 0.0)
    {
        vec3 xpos = getPosFromUVDepth(vec3(vec2(pixel) + 0.5, depth),
            u_camera.m_viewport, u_camera.m_inverse_projection_matrix);
        linear_depth = xpos.z;
        vec3 world_normal = DecodeNormal(texelFetch(u_normal, pixel, 0).xy);
        vec3 world_position = (u_camera.m_inverse_view_matrix *
            vec4(xpos, 1.0)).xyz;
        visibility = rtShadowLayerVisibility(layer, world_position,
            world_normal, xpos.z);
    }
    // Every layer has the depth, so a tap of the filter of the lighting pass
    // is one fetch
    imageStore(u_out, ivec3(texel, layer),
        vec4(visibility, linear_depth, 0.0, 0.0));
}
