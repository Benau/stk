// Spatial resolve of the solid reflection target (GEVulkanDrawCall::
// renderSolidReflectionResolve), a fullscreen draw of the reflection pass of
// GEVulkanDeferredFBOSplit which runs after the trace of the solid materials
// (solid_ssr.frag or solid_rt.frag) at the same reduced size
// (u_reflection_scale).
//
// The trace is stochastic (a sample of the specular lobe per ray, several rays
// per pixel), so its target is noisy at the size of its texels. The lighting
// calculation samples the target at its base level with the hardware bilinear
// filter (utils/handle_pbr.glsl), like the composite of FidelityFX SSSR: the
// noise is removed here, at the resolution of the trace, and not in the
// lighting pass, where a filter over the full size pixels would mix the
// reflection of different surfaces. This is the prefilter of the reflection
// denoiser of FidelityFX SSSR (FidelityFX DNSR,
// FFX_DNSR_Reflections_Prefilter): the center and a disk of 15 taps of the
// radius of its Halton(2,3) points ([-3, 3]), each weighted by
//   - the normal (pow(dot(normal), sigma)) and the linear depth
//     (exp(-distance * depth * sigma)), which stop the filter at the edges of
//     the surfaces, so the reflection of a surface is never averaged with the
//     one of another,
//   - the radiance, which gives almost no weight to a tap much brighter than
//     the average of the neighborhood (a firefly, the noise of one sample).
// The taps are the points of a Vogel spiral, which spreads them evenly over
// the disk, rotated by a random angle per texel so neighboring texels filter
// along different directions (the fixed taps of DNSR leave their pattern in
// the reflection without its temporal accumulation). The offsets of the taps
// are multiplied by the scale of the trace: the prefilter of DNSR runs at the
// size of the screen, a texel here covers u_reflection_scale full size
// pixels, so a tap of the same radius is u_reflection_scale texels away. The
// sigmas are reduced by the scale for the same reason.
//
// Every tap reads the mip chain of the target (generated by
// GEVulkanDeferredFBOSplit::generateReflectionMipmaps after the trace) at a
// level chosen like the level of the depth chain which SSAO fetches
// (utils/vbao.glsl): a tap of up to 2^u_mip_bias pixels of the screen reads
// the base level, the farther ones the next levels, so the outer ring of the
// disk averages the reflection of a wider area instead of reading a single
// noisy texel of the trace each.
//
// FidelityFX DNSR also has the temporal accumulation (there is no reflection
// history here, so the trace samples a rough lobe more than once, see
// solid_ssr.frag and solid_rt.frag) and a weight by the variance of the
// signal (the trace has no variance to store, so the radiance weight is
// computed against the average of the neighborhood here, which is a lower
// resolution texture in DNSR). The target stores the radiance premultiplied by
// its coverage, so the weighted average here is the average of the radiance
// weighted by the coverage and the alpha of the result is the coverage of the
// texel: a texel which no ray of the trace hit takes the reflection of its
// neighborhood, and if no tap has a reflection the lighting calculation keeps
// the specular IBL.
//
// Set 0 binding 0 is the target of the trace with its mip chain (sampled with
// a linear sampler at the level of the tap, the taps can be between the texels
// of a level), set 1 the camera and set 2 GVDFP_HDR (g-buffer, same as
// lighting)
layout(set = 0, binding = 0) uniform sampler2D u_trace;
layout(set = 2, binding = 1) uniform sampler2D u_normal;
layout(set = 2, binding = 2) uniform sampler2D u_depth;

layout(location = 0) out vec4 o_color;

#include "utils/camera.glsl"
#include "utils/constants_utils.glsl"
#include "utils/random.glsl"
#include "utils/unproject_position.glsl"
#include "../utils/decodeNormal.frag"

// FFX_DNSR_REFLECTIONS_PREFILTER_NORMAL_SIGMA
const float u_normal_sigma = 512.0;
// FFX_DNSR_REFLECTIONS_PREFILTER_DEPTH_SIGMA
const float u_depth_sigma = 4.0;
// FFX_DNSR_REFLECTIONS_RADIANCE_WEIGHT_BIAS
const float u_radiance_weight_bias = 0.6;
// The golden angle of the Vogel spiral of the taps and the radius of its disk,
// the extent of the taps of DNSR at the size of the screen
const float u_golden_angle = 2.3999632297;
const float u_tap_radius = 3.0;
// The level of the mip chain which a tap reads, chosen like the level of the
// depth chain which SSAO fetches (utils/vbao.glsl): a tap of up to
// 2^u_mip_bias = 10 pixels of the screen reads the base level, the farther
// ones the next levels, up to the deepest level of the chain of SSAO
const float u_mip_bias = 3.3;
const int u_max_mip = 3;

// The level of the target of a tap which is offset_px pixels of the screen
// away from the pixel, see the header
float getTapLevel(float offset_px)
{
    return clamp(round(log2(max(offset_px, 1.0)) - u_mip_bias), 0.0,
        float(min(u_max_mip, textureQueryLevels(u_trace) - 1)));
}

// The g-buffer pixel of a pixel of the reduced size target (the mapping of the
// trace)
ivec2 getGBufferPixel(vec2 trace_pixel)
{
    return min(ivec2(trace_pixel * float(u_reflection_scale)),
        ivec2(u_camera.m_screensize.xy) - 1);
}

void main()
{
    ivec2 trace_size = textureSize(u_trace, 0);
    ivec2 pixel = ivec2(gl_FragCoord.xy);
    if (pixel.x >= trace_size.x || pixel.y >= trace_size.y)
        discard;

    ivec2 gbuffer_pixel = getGBufferPixel(gl_FragCoord.xy);
    vec4 normal_data = texelFetch(u_normal, gbuffer_pixel, 0);
    float depth = texelFetch(u_depth, gbuffer_pixel, 0).x;
    // A pixel which is not glossy has nothing to reflect, and the sky has no
    // reflection to trace (the lighting calculation rejects it elsewhere)
    if (normal_data.z < 0.5 || depth == 0.0)
        discard;
    vec3 view_position = getPosFromUVDepth(vec3(vec2(gbuffer_pixel) + 0.5,
        depth), u_camera.m_viewport, u_camera.m_inverse_projection_matrix);
    vec3 world_normal = DecodeNormal(normal_data.xy);

    // The neighborhood of the filter, the center and the 15 taps. weights is
    // the edge stopping weight of a tap (1 for the center, 0 for a tap which
    // doesn't belong to the surface or has no reflection)
    vec4 samples[16];
    vec3 radiances[16];
    float weights[16];
    samples[0] = textureLod(u_trace, (vec2(pixel) + 0.5) / vec2(trace_size),
        0.0);
    radiances[0] = samples[0].rgb / max(samples[0].a, 1e-5);
    weights[0] = 1.0;

    // The reference of the radiance weight: the average of the radiance of the
    // neighborhood weighted by its coverage (the lower resolution average
    // radiance texture of DNSR)
    vec3 average_radiance = radiances[0] * samples[0].a;
    float average_coverage = samples[0].a;
    // The random rotation of the disk of the filter (see the header), the same
    // for the 15 taps of the texel
    float rotation = randomAngle(vec2(pixel));
    for (int i = 0; i < 15; i++)
    {
        // The i-th point of the Vogel spiral: the radius grows with the square
        // root so the taps cover the disk evenly, the angle by the golden angle
        // so they interleave. The radius of the prefilter is at the size of the
        // screen, a tap covers u_reflection_scale texels of the reduced size
        // target (see the header). Clamped like the sampler of the target
        float tap_radius = sqrt((float(i) + 0.5) / 15.0) * u_tap_radius;
        float tap_angle = float(i) * u_golden_angle + rotation;
        vec2 tap_offset = vec2(cos(tap_angle), sin(tap_angle)) * tap_radius;
        vec2 tap_position = clamp(vec2(pixel) + tap_offset *
            float(u_reflection_scale), vec2(0.0), vec2(trace_size) - 1.0);
        // The distance of the tap on the screen (a texel of the target covers
        // u_reflection_scale pixels of it), the unit of the level selection
        float tap_offset_px = length(tap_offset) *
            float(u_reflection_scale) * float(u_reflection_scale);
        samples[i + 1] = textureLod(u_trace, (tap_position + 0.5) /
            vec2(trace_size), getTapLevel(tap_offset_px));
        radiances[i + 1] = samples[i + 1].rgb /
            max(samples[i + 1].a, 1e-5);
        weights[i + 1] = 0.0;
        if (samples[i + 1].a <= 0.0)
            continue;
        ivec2 tap_gbuffer_pixel = getGBufferPixel(tap_position + 0.5);
        vec4 tap_normal_data = texelFetch(u_normal, tap_gbuffer_pixel, 0);
        float tap_depth = texelFetch(u_depth, tap_gbuffer_pixel, 0).x;
        if (tap_normal_data.z < 0.5 || tap_depth == 0.0)
            continue;
        vec3 tap_view_position = getPosFromUVDepth(
            vec3(vec2(tap_gbuffer_pixel) + 0.5, tap_depth),
            u_camera.m_viewport, u_camera.m_inverse_projection_matrix);
        // FFX_DNSR_Reflections_GetEdgeStoppingDepthWeight, in the view space
        // depth of the camera (the same unit)
        float depth_weight = exp(-abs(tap_view_position.z -
            view_position.z) * abs(view_position.z) *
            (u_depth_sigma / float(u_reflection_scale)));
        if (depth_weight < 1e-5)
            continue;
        // FFX_DNSR_Reflections_GetEdgeStoppingNormalWeight
        float normal_weight = pow(max(dot(DecodeNormal(tap_normal_data.xy),
            world_normal), 0.0),
            u_normal_sigma / float(u_reflection_scale));
        if (normal_weight < 1e-5)
            continue;
        // The gloss is the roughness of the PBR data: the lobes of different
        // roughness are not the same reflection (a material edge keeps its
        // own)
        float gloss_weight = 1.0 - smoothstep(0.05, 0.15,
            abs(tap_normal_data.z - normal_data.z));
        if (gloss_weight <= 0.0)
            continue;
        weights[i + 1] = depth_weight * normal_weight * gloss_weight;
        average_radiance += radiances[i + 1] * samples[i + 1].a *
            weights[i + 1];
        average_coverage += samples[i + 1].a * weights[i + 1];
    }
    if (average_coverage <= 0.0)
        discard;
    average_radiance /= average_coverage;

    // FFX_DNSR_Reflections_GetRadianceWeight, without the variance of the
    // signal (see the header): the hit radiance of the neighborhood is the
    // radiance of the same surface, so a tap which is much brighter than the
    // average is a firefly and gets almost no weight
    vec4 sum = vec4(0.0);
    float weight_sum = 0.0;
    for (int i = 0; i < 16; i++)
    {
        if (samples[i].a <= 0.0)
            continue;
        float weight = max(exp(-u_radiance_weight_bias * length(
            average_radiance - radiances[i])), 1e-2) * weights[i];
        if (weight <= 0.0)
            continue;
        sum += samples[i] * weight;
        weight_sum += weight;
    }
    // Premultiplied: the weighted average of the premultiplied radiance is the
    // average of the radiance weighted by the coverage, and the alpha of the
    // result is the coverage of the texel. A texel which no tap reached keeps
    // no coverage and the specular IBL of the lighting calculation
    o_color = weight_sum > 0.0 ? sum / weight_sum : vec4(0.0);
}
