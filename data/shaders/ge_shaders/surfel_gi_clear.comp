// First pass of GEVulkanSurfelGI (see utils/surfel_gi.glsl): the cells of the
// grid are empty (and nothing was spawned in them), and with m_reset (the
// first frame, or the static scene was built again so the surfels are on
// triangles which are gone) every surfel is free
layout(local_size_x = 64) in;

#define SURFEL_SET 2
#include "utils/surfel_gi.glsl"

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < SURFEL_CELL_COUNT)
    {
        u_cell_count[i] = 0u;
        u_cell_spawns[i] = 0u;
    }
    if (pc.m_reset == 0u || i >= SURFEL_MAX)
        return;
    u_surfels[i].m_radius = 0.0;
    // Popped from the end, so the first surfels are used first
    u_pool.m_free[i] = SURFEL_MAX - 1u - i;
    if (i == 0u)
        u_pool.m_free_count = int(SURFEL_MAX);
}
