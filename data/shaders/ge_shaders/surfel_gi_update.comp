// Second pass of GEVulkanSurfelGI (see utils/surfel_gi.glsl), one thread per
// surfel of the pool: a surfel which no pixel used for its life (from
// SURFEL_MAX_LIFE ms down to SURFEL_MIN_LIFE ms when the pool is almost
// empty), is free again. The others get
// the radius of their distance to the cameras and are added to the cell of
// their center in the levels which the pixels around them can look in: the
// level of a pixel is the one of its distance, which is the distance of the
// surfel plus or minus the radius at most. A pixel looks in the 2x2x2 cells
// nearest to it, the radius is at most half a cell so they have every surfel
// which touches it. With the frame cache, the surfels which trace in this
// frame are put in the lists of surfel_gi_trace.comp (see u_trace_lists)
#extension GL_EXT_ray_query : require
layout(local_size_x = 64) in;

#include "utils/surfel_gi_transport.glsl"

// The surfels of the group in the lists of the trace (one atomic of a list for
// the group), and the first of them in the lists
shared uint s_trace_count[2];
shared uint s_trace_first[2];

bool anchorSurface(uvec4 anchor, out vec3 position, out vec3 normal)
{
    if (anchor.x >= pc.m_geometry_count)
        return false;
    RTGeometry geometry = u_rt_geometries[anchor.x];
    if (geometry.m_owner != anchor.w ||
        !canAttachDynamicSurfel(geometry.m_bounds_min.xyz, geometry.m_bounds_max.xyz))
        return false;
    vec2 uv = unpackUnorm2x16(anchor.z);
    vec3 bary = vec3(1.0 - uv.x - uv.y, uv);
    vec3 local_position = vec3(0.0);
    vec3 local_normal = vec3(0.0);
    for (uint corner = 0u; corner < 3u; ++corner)
    {
        uint vertex = getRTIndex(geometry, anchor.y * 3u + corner);
        local_position += bary[corner] * getRTVertexPosition(geometry, vertex);
        local_normal += bary[corner] * getRTVertexNormal(geometry, vertex);
    }
    mat3 rows = mat3(geometry.m_row0.xyz, geometry.m_row1.xyz, geometry.m_row2.xyz);
    position = local_position * rows + vec3(geometry.m_row0.w, geometry.m_row1.w, geometry.m_row2.w);
    if (abs(determinant(rows)) < 1e-12 || dot(local_normal, local_normal) < 1e-10)
        return false;
    normal = normalize(inverse(rows) * local_normal);
    return true;
}

// ----------------------------------------------------------------------------
// Returns the list of the trace of the surfel with the frame cache
// (SURFEL_TRACE_*), or -1 if it doesn't trace in this frame (or it's free)
int updateSurfel(uint id)
{
    if (id >= pc.m_surfel_count || u_surfels[id].m_radius == 0.0)
        return -1;
    vec3 position = u_surfels[id].m_position;
    uvec4 anchor = lighting[id].anchor;
    bool valid = true;
    if (anchor.w != 0u)
    {
        vec3 normal;
        vec3 attached;
        valid = anchorSurface(anchor, attached, normal);
        if (valid)
        {
            float motion = distance(position, attached) / u_surfels[id].m_radius;
            float alignment = dot(normal, u_surfels[id].m_normal);
            if (motion >= 1.0 || alignment < 0.7)
            {
                lighting[id].frame = 0u;
                lighting[id].guide = 0u;
                lighting[id].local_irradiance = vec4(0.0);
                lighting[id].variance = 0.0;
                u_surfels[id].m_samples = 0.0;
            }
            else
                lighting[id].local_irradiance.w *= (1.0 - smoothstep(0.1, 1.0, motion)) * smoothstep(0.7, 0.98, alignment);
            position = attached;
            u_surfels[id].m_position = attached;
            u_surfels[id].m_normal = normal;
        }
    }
    float camera_distance = getSurfelCameraDistance(position);
    // The free count grows while this pass frees surfels, so the threads
    // which read it later keep more of theirs: it stops when there is enough
    // room again
    float low_pool = 0.25 * float(pc.m_surfel_count);
    float room = clamp(float(u_pool.m_free_count) / low_pool, 0.0, 1.0);
    uint life = uint(mix(float(SURFEL_MIN_LIFE), float(SURFEL_MAX_LIFE),
        room));
    if (valid)
        valid = anchor.x < pc.m_geometry_count && passesAlphaTest(anchor.x, anchor.y,
            unpackUnorm2x16(anchor.z), camera_distance);
    if (!valid || pc.m_time - u_surfels[id].m_last_seen > life || lighting[id].buried != 0u)
    {
        u_surfels[id].m_radius = 0.0;
        int at = atomicAdd(u_pool.m_free_count, 1);
        u_pool.m_free[at] = id;
        return -1;
    }

    float radius = getSurfelRadius(camera_distance);
    u_surfels[id].m_radius = radius;
    binSurfel(id, position, camera_distance, radius);
    if (lighting[id].local_irradiance.w < SURFEL_MAX_SAMPLES)
        return int(SURFEL_TRACE_YOUNG);
    if ((pc.m_cache & SURFEL_CACHE_FRAME) == 0u || (id + pc.m_frame) % SURFEL_CACHED_TRACE_PERIOD == 0u)
        return int(SURFEL_TRACE_CONVERGED);
    return -1;
}   // updateSurfel

// ----------------------------------------------------------------------------
void main()
{
    if (gl_LocalInvocationIndex < 2u)
        s_trace_count[gl_LocalInvocationIndex] = 0u;
    barrier();
    uint id = gl_GlobalInvocationID.x;
    int list = updateSurfel(id);
    uint slot = 0u;
    if (list >= 0)
        slot = atomicAdd(s_trace_count[list], 1u);
    barrier();
    if (gl_LocalInvocationIndex < 2u &&
        s_trace_count[gl_LocalInvocationIndex] != 0u)
    {
        uint l = gl_LocalInvocationIndex;
        uint first = atomicAdd(u_trace_lists.m_count[l], s_trace_count[l]);
        s_trace_first[l] = first;
    }
    barrier();
    if (list >= 0)
    {
        u_trace_lists.m_ids[uint(list) * pc.m_surfel_count +
            s_trace_first[list] + slot] = id;
    }
}
