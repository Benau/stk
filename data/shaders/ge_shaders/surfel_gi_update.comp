// The surfels which are alive of GEVulkanSurfelGI, one thread for every slot
// of the pool: each of them follows the triangle it's attached to (the vertex
// which moved with its node, see utils/surfel_gi_rt.glsl), updates its radius
// from its distance to the camera, registers itself in the cells it covers
// (a surfel is in several of the 27 cells around it, the offsets are computed
// by surfel_gi_cell_info.comp) and asks for the rays of the frame. A surfel
// whose surface turns under it (the wheels of a kart) invalidates the history
// of its old normal (its 6x6 irradiance map and its mean), see the reset below.
// The surfels which are not seen, are too far or are too old go back to the
// stack of the free surfels, so the pool is used by the surfaces which are
// around the camera.
//
// The rays of a surfel of the frame follow the noise of its mean (the
// multiscale estimator of an adaptive sampling of GIBS and of the reference
// article: the surfels whose pixels would show the noise trace more rays, a
// converged one traces 2), its age (the first frames of a surfel are the ones
// which converge it) and whether the camera sees it (the surfels of the
// surfaces which it doesn't see are most of the pool). The sum of the rays of
// the frame is bounded softly by SURFEL_RAY_TARGET: when the previous frame
// asked for more, every surfel gets a part of its rays, so the budget of the
// frame is the same without the surfels of a part of the pool losing all of
// them at once (the tracing is the mass of the cost of the frame).
//
// Set 0 is the one of GEVulkanRTScene (the transformations of the nodes),
// set 1 the camera and the global light (both only to share the includes of
// utils/rt_scene.glsl), set 2 the pool of the surfels
#extension GL_EXT_ray_query : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define MESH_TEXTURES_SET 3

#include "utils/surfel_gi.glsl"
#include "utils/camera.glsl"
#include "utils/constants_utils.glsl"
#include "utils/get_vertex_color.glsl"
#include "utils/sample_mesh_texture.glsl"
#include "utils/rt_utils.glsl"
#include "utils/rt_scene.glsl"
#include "utils/surfel_gi_rt.glsl"

// Cosine of the largest turn of the normal of a surfel which keeps its
// history (about 20 degrees): a wheel rotating under its surfels, or any
// surface which turns with its node, is not the surface its samples came from
const float SURFEL_NORMAL_TURN_COS = 0.94;

// The rays and the active surfels of the group, added to the counters of the
// frame by its first thread (a shared reduction, the atomicAdd of every surfel
// of the pool would be one contention of the whole pool on one counter)
shared uint g_rays;
shared uint g_requests;

void main()
{
    const uint index = gl_GlobalInvocationID.x;
    const uint thread = gl_LocalInvocationIndex;
    if (thread == 0u)
    {
        g_rays = 0u;
        g_requests = 0u;
    }
    barrier();

    uint ray_count = 0u;
    uint request_count = 0u;
    bool is_active = false;
    bool live = false;
    Surfel surfel;
    if (index < SURFEL_MAX_COUNT)
    {
        surfel = u_surfels[index];
        live = (surfel.m_status & SURFEL_STATUS_ALIVE) != 0u;
    }
    if (live)
    {
        // The rays the surfel traced since it was created, the index of the R3
        // sequence of its next ray (a surfel only traces once it has 64 rays,
        // see surfel_gi_trace.comp)
        surfel.m_ray_index += surfel.m_ray_count;
        // The mean of the previous frame, the input of the irradiance of the
        // pixels and of the field of this frame (the "radiance" of SurfelPlus,
        // the share of the previous frame wrote it)
        surfel.m_radiance = surfel.m_msme.m_mean;

        const bool seen = (surfel.m_status & SURFEL_STATUS_SEEN) != 0u;
        // Its radiance was used by the field of the rays of another surfel or
        // by a pixel, so it's part of the GI even if the camera doesn't see it
        const bool refed = (surfel.m_status & SURFEL_STATUS_REFED) != 0u;
        const bool sleeping =
            (surfel.m_status & SURFEL_STATUS_SLEEPING) != 0u;
        // The life is reset while the surfel is seen, so a surfel of a surface
        // which is not visible (behind the camera, occluded, far) is recycled
        surfel.m_life = surfel.m_life == 0u ? 0u : surfel.m_life - 1u;
        surfel.m_frame = min(surfel.m_frame + 1u, 65535u);
        if (seen)
        {
            surfel.m_life = SURFEL_MAX_LIFE;
            surfel.m_last_seen = pc.m_frame;
        }
        else if (sleeping && refed)
        {
            // A sleeping surfel which the field of a ray used is still needed
            // (it's outside of the view, so its pixels don't keep it)
            surfel.m_life = max(surfel.m_life, SURFEL_SLEEPING_LIFE);
        }
        if (seen)
        {
            // The surface entered the view: the surfel of the tracing is the
            // surfel of the camera's pixels now, and it's traced from now on
            surfel.m_status &= ~SURFEL_STATUS_SLEEPING;
            if (sleeping)
                surfel.m_life = SURFEL_MAX_LIFE;
        }

        // The position and the normal of the triangle of the surfel in this
        // frame
        const vec3 previous_normal = surfel.m_normal;
        vec3 position;
        vec3 normal;
        const bool followed = surfelFollow(surfel, position, normal);
        surfel.m_position = position;
        surfel.m_normal = normal;
        // The surface turned under the surfel: its 6x6 irradiance map is in the
        // frame of the normal it was integrated with, so it can't be rotated
        // (it would guide the rays of the new surface to the directions of the
        // old one), and its mean is the light of the old surface. The map is
        // cleared (the integrate pass fills it again and the guiding waits for
        // it) and the estimator is widened, so the mean catches up with the
        // samples of the new surface instead of averaging the light of the two.
        // A translation of the node, or a rotation which doesn't turn the
        // triangle of the surfel, is still a harmless move of the surfel and
        // keeps its history
        const bool turned = dot(previous_normal, normal) <
            SURFEL_NORMAL_TURN_COS;
        if (turned)
        {
            surfel.m_irradiance = 0u;
            // The map of the old surface is cleared by the integration (a map
            // of 0 is the one of a new surfel), and the depth moments of the
            // old surface can't hide the new one
            u_surfel_lights[index].m_depth_range = 0.0;
            // The light of the new surface can be far from the light of the old
            // one, which is the only value the surfel has: the variance is the
            // uncertainty of a surface whose light can change by half of it, so
            // the clamp of the samples doesn't hold the new light back, and the
            // difference of the mean and its short mean is large in standard
            // deviations (the catch up of the mean of surfelMSME)
            const vec3 light = surfel.m_msme.m_short_mean;
            surfel.m_msme.m_variance = max(surfel.m_msme.m_variance,
                light * light * 0.25 + 1.0e-4);
            surfel.m_msme.m_inconsistency = 1.0;
            surfel.m_msme.m_vbbr = max(surfel.m_msme.m_vbbr, 0.5);
        }
        const float camera_distance = distance(position, pc.m_origin.xyz);

        bool recycle = !followed || surfel.m_radius < 0.001 ||
            surfel.m_life == 0u;
        if (!recycle && (sleeping || (!seen && !refed)))
        {
            // Far surfels, old surfels and a full pool recycle the ones which
            // are not seen (the sleeping ones first, their field has the
            // lowest value), the surfels of the surface around the camera stay
            const float distance_factor = smoothstep(50.0, 100.0,
                camera_distance);
            float life_factor = float(SURFEL_MAX_LIFE - surfel.m_life) /
                float(SURFEL_MAX_LIFE);
            life_factor *= life_factor;
            float recycle_probability = 0.1 * distance_factor +
                0.4 * life_factor;
            if (sleeping)
                recycle_probability = max(recycle_probability, 0.2);
            const float fullness = float(u_counter.m_alive) /
                float(SURFEL_MAX_COUNT);
            recycle_probability *= fullness * step(0.8, fullness);
            recycle = surfelRand(index, pc.m_frame) < recycle_probability;
        }
        if (recycle)
        {
            // The status is cleared so the surfel is not alive until it's
            // allocated again (see surfelFree)
            u_surfels[index].m_status = 0u;
            surfelFree(index);
            live = false;
        }
    }
    if (live)
    {
        // Radius of the pixels which the surfel covers, at most the size of the
        // cell of the grid at its distance (a surfel is never larger than its
        // cell)
        const float camera_distance = distance(surfel.m_position,
            pc.m_origin.xyz);
        const bool seen = (surfel.m_status & SURFEL_STATUS_SEEN) != 0u;
        const float max_radius = surfelMaxRadius(camera_distance);
        float new_radius = min(surfelCoverRadius(camera_distance), max_radius);
        if (seen)
            new_radius = mix(surfel.m_radius, new_radius, 0.1);
        new_radius = max(new_radius, max_radius * SURFEL_MIN_SIZE_RATIO);
        // A change of the size of the surfel changes the samples it merges, so
        // a discontinuous change widens the estimator. The radius follows the
        // camera every frame, and the reference multiplies the variance every
        // frame: with a radius which moves continuously that product grows
        // faster than the estimator shrinks it, so the variance never falls,
        // the mean stays at its (wrong) initial value and the surfel never
        // converges
        const float radius_difference = abs(surfel.m_radius - new_radius);
        if (radius_difference > 0.1 * new_radius)
            surfel.m_msme.m_variance *= 1.0 + radius_difference * 10.0;
        surfel.m_radius = new_radius;

        // The compact copy of the fields which the passes of the cells read
        // (the row sums of its irradiance map didn't change, they're kept, and
        // the depth moments of a turned surface were reset above)
        u_surfel_lights[index].m_position_radius = vec4(surfel.m_position,
            surfel.m_radius);
        u_surfel_lights[index].m_normal_frame = vec4(surfel.m_normal,
            float(surfel.m_frame));
        u_surfel_lights[index].m_radiance = surfel.m_radiance;

        // The cells the sphere of the surfel intersects, see
        // surfel_gi_cell_to_surfel.comp (which writes the list)
        const ivec4 cell = surfelCell(surfel.m_position);
        for (int i = 0; i < 27; i++)
        {
            const ivec4 neighbour = cell + ivec4(SURFEL_NEIGHBORS[i], 0);
            if (!surfelIntersectsCell(surfel, neighbour))
                continue;
            atomicAdd(u_cells[surfelCellIndex(neighbour)].m_count, 1u);
        }

        const bool turned = (surfel.m_status & SURFEL_STATUS_TURNED) != 0u;
        const bool sleeping =
            (surfel.m_status & SURFEL_STATUS_SLEEPING) != 0u;
        // More rays for a surfel which is not converged: the noise of its mean
        // (the relative standard error of its rays, see surfelMeanNoise) decides
        // its number of rays between 2 and the maximum. A converged surfel still
        // asks for 2 rays, so its estimator follows a change of its lighting
        const float noise = surfelMeanNoise(surfel.m_msme);
        request_count = uint(mix(2.0, float(SURFEL_MAX_RAYS), smoothstep(
            SURFEL_NOISE_LOW, SURFEL_NOISE_HIGH, noise)) + 0.5);
        // The first frames of a surfel are the ones which converge it, and the
        // light of a surface which turned under its surfel is unknown (the
        // reset above), so the surfel asks for all the rays: twice the rays
        // while it's warmed up (the first SURFEL_WARMUP_FRAMES, the ones which
        // move its mean, see surfel_gi_integrate.comp), the usual all while
        // it's young
        if (turned || surfel.m_frame < 20u)
            request_count = SURFEL_MAX_RAYS;
        if (surfel.m_frame < SURFEL_WARMUP_FRAMES)
            request_count = SURFEL_WARMUP_RAYS;
        // A surfel which the camera doesn't see costs a part of it (the
        // surfels which it doesn't see are most of the pool, and their light is
        // the light of the surfaces which are a bit outside of the view)
        if (!seen)
            request_count = max(1u, request_count / 4u);
        if (sleeping)
            request_count = 0u;

        // The soft budget: when the surfels of the previous frame asked for
        // more than SURFEL_RAY_TARGET rays, the rays of every surfel are cut by
        // the ratio (with a random rounding, so the cut surfels are not the
        // same from one frame to the next)
        ray_count = request_count;
        const uint last_requests = max(u_counter.m_last_ray_requests, 1u);
        if (last_requests > SURFEL_RAY_TARGET && ray_count > 1u)
        {
            const float scaled = float(ray_count) * float(SURFEL_RAY_TARGET) /
                float(last_requests);
            ray_count = min(ray_count, max(1u, uint(scaled + surfelRand(index,
                pc.m_frame + 5u))));
        }
        // The cost of the frame is bounded by the ray buffer of the pool, the
        // surfels which don't get a range keep their radiance (see
        // SURFEL_RAY_BUDGET)
        const uint ray_offset = atomicAdd(u_counter.m_rays, ray_count);
        if (ray_offset + ray_count <= SURFEL_RAY_BUDGET)
        {
            for (uint i = 0; i < ray_count; i++)
                u_ray_ids[ray_offset + i] = index;
            surfel.m_ray_offset = ray_offset;
            surfel.m_ray_count = ray_count;
            is_active = true;
        }
        else
        {
            // The rays are given back, so the surfels which are allocated after
            // this one can still use the budget (the same as the reference)
            atomicAdd(u_counter.m_rays, uint(-int(ray_count)));
            surfel.m_ray_count = 0u;
        }

        // The bits of this frame are consumed, the pool bit stays, and the
        // integrate pass of this frame sees that the surface turned (one frame)
        surfel.m_status = SURFEL_STATUS_ALIVE |
            (turned ? SURFEL_STATUS_TURNED : 0u) |
            (sleeping ? SURFEL_STATUS_SLEEPING : 0u);
        u_surfels[index] = surfel;
    }

    // The sum of the rays and of the surfels of the block, and the list of the
    // surfels which have rays (the integration dispatches one group for every
    // of them, see surfel_gi_cell_info.comp). The index of the list is the
    // global counter: the surfels of the whole pool share it
    if (is_active)
        u_active[atomicAdd(u_counter.m_active, 1u)] = index;
    if (index < SURFEL_MAX_COUNT)
    {
        atomicAdd(g_rays, ray_count);
        atomicAdd(g_requests, request_count);
    }
    barrier();
    if (thread == 0u)
    {
        atomicAdd(u_counter.m_rays, g_rays);
        atomicAdd(u_counter.m_ray_requests, g_requests);
    }
}
