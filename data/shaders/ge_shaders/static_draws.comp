// GPU culling of the static scene (see GEVulkanStaticDrawSource). Each thread
// tests one source instance and appends it to the object data of its draw
// command, the command was copied from the template with a zero instance
// count just before this dispatch.
layout(local_size_x = 64) in;

// The uniform buffer of the view that is culled (set 0, binding 0)
#define CAMERA_SET 0
#include "utils/camera.glsl"

layout(push_constant) uniform LODConstants
{
    // The camera position used to select the level of detail (xyz)
    vec4 m_lod_camera;
} u_lod;

struct Source
{
    uvec4 object_data[4];
    vec3 origin;
    int min_distance;
    vec3 min_edge;
    int max_distance;
    vec3 max_edge;
    uint command;
};

struct Draw
{
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

layout(std430, set = 0, binding = 1) readonly buffer Sources
{
    Source sources[];
};

layout(std430, set = 0, binding = 2) buffer Commands
{
    Draw draws[];
};

layout(std430, set = 0, binding = 3) writeonly buffer Objects
{
    uvec4 objects[];
};

// The polygons of the visible objects of each workgroup, always written (even
// if zero) so it needs no clearing, the CPU sums it a few frames later
layout(std430, set = 0, binding = 4) writeonly buffer Stats
{
    uint group_polys[];
};

shared uint s_polys;

// ----------------------------------------------------------------------------
bool isVisible(const Source source)
{
    // Squared distance interval of the level of detail, the maximum is
    // negative if there is none
    vec3 delta = u_lod.m_lod_camera.xyz - source.origin;
    precise float squared = delta.x * delta.x + delta.y * delta.y +
        delta.z * delta.z;
    int distance_sq = int(squared);
    if (distance_sq < source.min_distance ||
        (source.max_distance >= 0 && distance_sq >= source.max_distance))
        return false;

    // Same tests as GECullingTool::isCulled, the box of the camera first
    if (any(lessThan(source.max_edge, u_camera.m_view_min_edge.xyz)) ||
        any(greaterThan(source.min_edge, u_camera.m_view_max_edge.xyz)))
        return false;
    for (int i = 0; i < 6; i++)
    {
        vec4 plane = u_camera.m_frustum[i];
        // The corner of the box which is the furthest along the normal
        vec3 corner = mix(source.min_edge, source.max_edge,
            greaterThanEqual(plane.xyz, vec3(0.0)));
        if (dot(plane, vec4(corner, 1.0)) < 0.0)
            return false;
    }
    return true;
}   // isVisible

// ----------------------------------------------------------------------------
void main()
{
    // All the threads must reach the barriers, so no early return
    if (gl_LocalInvocationIndex == 0u)
        s_polys = 0u;
    memoryBarrierShared();
    barrier();

    uint index = gl_GlobalInvocationID.x;
    if (index < uint(sources.length()))
    {
        Source source = sources[index];
        if (isVisible(source))
        {
            uint slot = atomicAdd(draws[source.command].instance_count, 1u);
            uint dest = (draws[source.command].first_instance + slot) * 4u;
            for (uint word = 0u; word < 4u; word++)
                objects[dest + word] = source.object_data[word];
            atomicAdd(s_polys, draws[source.command].index_count / 3u);
        }
    }

    memoryBarrierShared();
    barrier();
    if (gl_LocalInvocationIndex == 0u)
        group_polys[gl_WorkGroupID.x] = s_polys;
}   // main
