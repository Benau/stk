// One direction (pc.m_misc.yz) of the blur of the half size ambient occlusion
// of GEVulkanSSAO, which doesn't blur over the edges of the depth and never
// reads outside of the rect of the viewport. u_depth is the depth chain, the
// depth of a pixel is the one of the first pixel of its 2x2 block (where the
// occlusion was evaluated).
//
// The width of the blur is a part of the height of the viewport (a gaussian
// with a sigma of 1 texel of the half size image at the reference height, like
// the other blurs, pc.m_params.w is the scale), so it looks the same at any
// resolution and render scale
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "utils/ssao_common.glsl"

layout(set = 0, binding = 0) uniform sampler2D u_ao;
layout(set = 0, binding = 1) uniform sampler2D u_depth;
layout(set = 0, binding = 2, SSAO_AO_FORMAT) uniform writeonly image2D u_out;

// More taps would be a lot of fetches, the blur is a bit narrower than it
// should be for a height of more than 3 times the reference
const int MAX_TAP_RADIUS = 6;
// Lower resolutions can't have less than this (a tap of 1 texel is needed)
const float MIN_SIGMA = 0.5;

float blockDepth(ivec2 block)
{
    ivec2 pixel = clamp(block * 2, pc.m_rect.xy, pc.m_rect.zw - 1);
    return texelFetch(u_depth, pixel, 0).x;
}

void main()
{
    const ivec4 half_rect = ssaoHalfRect(pc.m_rect);
    const ivec2 block = half_rect.xy + ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(block, half_rect.zw)))
        return;

    // Scale the Gaussian sigma by 1.75, then sample out to 2 sigma on each
    // side (taps are spaced one half-resolution texel apart, so none are
    // skipped)
    const float sigma = max(pc.m_params.w * 1.75, MIN_SIGMA);
    const int tap_radius = min(int(ceil(2.0 * sigma)), MAX_TAP_RADIUS);
    const float exponent_scale = -0.5 / (sigma * sigma);
    const ivec2 direction = pc.m_misc.yz;
    float center_z = blockDepth(block);
    float sum = 0.0;
    float weight_sum = 0.0;
    for (int i = -tap_radius; i <= tap_radius; i++)
    {
        ivec2 q = clamp(block + direction * i, half_rect.xy,
            half_rect.zw - 1);
        float w = exp(float(i * i) * exponent_scale) *
            ssaoDepthWeight(center_z, blockDepth(q));
        sum += w * texelFetch(u_ao, q, 0).x;
        weight_sum += w;
    }
    // The center always has weight
    float visibility = sum / weight_sum;
    imageStore(u_out, block, vec4(vec3(visibility), 1.0));
}
