// Screen space ambient occlusion of GEVulkanSSAO, at half the size of the
// g-buffer: one thread for every 2x2 block, evaluated at the first pixel of
// it. The result is the visibility (1.0 = not occluded), which ssao_blur.comp
// and ssao_upsample.comp turn into the full size image that the lighting pass
// multiplies the ambient light by.
//
// The estimator is VBAO (Visibility Bitmask Ambient Occlusion, Therrien et al,
// "Screen Space Indirect Lighting with Visibility Bitmask"), translated from
// the one of Bevy (bevy_pbr/src/ssao/ssao.wesl, based on XeGTAO, SSILVB and
// SSRT3). The slices, the sectors and the visibility bitmasks are in
// utils/vbao.glsl, which ssil.comp also uses to light the scene with the
// visibility of the same masks. The normal is the one of the g-buffer (also
// used by solid_ssr.frag), the depth is the linear one of the chain
// (ssao_depth.comp, ssao_depth_down.comp)
//
// Only estimateVisibility() depends on the algorithm (the inputs and the
// output are always the same)
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "utils/ssao_common.glsl"

layout(set = 0, binding = 0) uniform sampler2D u_depth;
layout(set = 0, binding = 1) uniform sampler2D u_normal;
layout(set = 0, binding = 2, SSAO_AO_FORMAT) uniform writeonly image2D u_ao;

#include "../utils/decodeNormal.frag"
#include "utils/vbao.glsl"

// The estimator. Inputs: the pixel (full size coordinates, inside the rect
// of the viewport), its view space position and normal, and the depth chain
// for the others. Output: the visibility in [0, 1]
float estimateVisibility(ivec2 pixel, vec3 pos, vec3 normal)
{
    const float radius = pc.m_params.x;
    const float radius_px = radiusInPixels(radius, abs(pos.z));
    if (radius_px < 1.0)
        return 1.0;

    // The view vector, from the point to the camera
    const vec3 view = normalize(-pos);
    // Thickness of the object which a sample is assumed to belong to
    const float thickness = THICKNESS_RATIO * radius;
    const float normal_bias = NORMAL_BIAS_RATIO * radius;
    const float slice_count = float(SLICE_COUNT);
    const float samples_per_slice_side = float(SAMPLES_PER_SLICE_SIDE);
    const float samples_per_slice = float(SECTOR_COUNT);
    // The noise is designed for consecutive coordinates in the half size
    // image, it rotates the slices and offsets the samples of every block
    const vec2 noise = loadNoise(pixel >> 1);

    uint occluded_count = 0u;
    for (int slice = 0; slice < SLICE_COUNT; slice++)
    {
        const float slice_t = float(slice);
        // The slices cover the half circle around the view direction
        const float phi = (PI / slice_count) * (slice_t + noise.x);
        const vec2 omega = vec2(cos(phi), sin(phi));
        float n;
        if (!vbaoSampleDirection(view, normal, omega, n))
            continue;

        uint bitmask = 0u;
        for (int sample_i = 0; sample_i < SAMPLES_PER_SLICE_SIDE; sample_i++)
        {
            const float sample_t = float(sample_i);
            // Every sample of the slice has its own offset, from the golden
            // ratio sequence (the same as Bevy)
            const float sample_noise = fract(noise.y + (slice_t +
                sample_t * samples_per_slice_side) * 0.6180339887498948482);
            // The samples are closer to the pixel than to the edge of the
            // radius (https://github.com/GameTechDev/XeGTAO#sample-distribution)
            float s = (sample_t + sample_noise) / samples_per_slice_side;
            s *= s;
            const float offset_px = s * radius_px;
            // Farther samples fetch the next levels of the depth chain, so the
            // distance between the texels which are fetched is about the same
            // (https://github.com/GameTechDev/XeGTAO#memory-bandwidth-bottleneck)
            const int mip = clamp(int(round(log2(max(offset_px, 1.0)) -
                MIP_BIAS)), 0, MAX_MIP);
            const ivec2 offset = ivec2(round(omega * offset_px));

            // Both sides of the view vector, like GTAO
            float sample_z_1;
            const vec3 sample_pos_1 = fetchSamplePosition(pixel + offset,
                mip, sample_z_1);
            const vec3 delta_1 = sample_pos_1 - pos;
            // The sky doesn't occlude
            if (sample_z_1 < 0.5 * SSAO_SKY_Z &&
                isOccluder(delta_1, normal, normal_bias))
            {
                processSample(delta_1, view, thickness, -1.0, n,
                    samples_per_slice, bitmask);
            }

            float sample_z_2;
            const vec3 sample_pos_2 = fetchSamplePosition(pixel - offset,
                mip, sample_z_2);
            const vec3 delta_2 = sample_pos_2 - pos;
            if (sample_z_2 < 0.5 * SSAO_SKY_Z &&
                isOccluder(delta_2, normal, normal_bias))
            {
                processSample(delta_2, view, thickness, 1.0, n,
                    samples_per_slice, bitmask);
            }
        }
        occluded_count += bitCount(bitmask);
    }

    return clamp(1.0 - float(occluded_count) /
        (slice_count * 2.0 * samples_per_slice_side), 0.03, 1.0);
}

void main()
{
    const ivec4 half_rect = ssaoHalfRect(pc.m_rect);
    const ivec2 block = half_rect.xy + ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(block, half_rect.zw)))
        return;

    ivec2 pixel = clamp(block * 2, pc.m_rect.xy, pc.m_rect.zw - 1);
    float visibility = 1.0;
    float z = texelFetch(u_depth, pixel, 0).x;
    if (z < 0.5 * SSAO_SKY_Z)
    {
        initRays();
        vec3 pos = viewRay(vec2(pixel) + 0.5) * z;
        // View space normal, same as solid_ssr.frag
        vec4 normal_data = texelFetch(u_normal, pixel, 0);
        vec3 normal = normalize((u_camera.m_view_matrix *
            vec4(DecodeNormal(normal_data.xy), 0.0)).xyz);
        visibility = estimateVisibility(pixel, pos, normal);
    }
    imageStore(u_ao, block, vec4(vec3(visibility), 1.0));
}
