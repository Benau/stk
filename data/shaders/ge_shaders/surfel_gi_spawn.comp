// Before tracing, choose at most one surface from each participating tile.
#extension GL_EXT_ray_query : require

layout(local_size_x = 4, local_size_y = 4) in;

#include "utils/surfel_gi_apply.glsl"

shared uint candidate;

void main()
{
    ivec2 first = pc.m_rect.xy + ivec2(gl_WorkGroupID.xy * gl_WorkGroupSize.xy) * 2;
    if (!isSurfelSpawnTurn(first))
        return;
    if (gl_LocalInvocationIndex == 0u)
        candidate = ~0u;
    barrier();
    uint seed = gl_WorkGroupID.x * 1973u + gl_WorkGroupID.y * 9277u + pc.m_frame * 26699u;
    uint phase = uint(getSurfelRandom(seed) * 4.0);
    ivec2 pixel = first + ivec2(gl_LocalInvocationID.xy) * 2 + ivec2(phase & 1u, (phase >> 1u) & 1u);
    SurfelPixel p;
    SurfelGather gathered;
    if (all(lessThan(pixel, pc.m_rect.zw)) && loadSurfelPixel(pixel, p))
    {
        gathered = gatherSurfels(p);
        atomicMin(candidate, getSurfelSpawnKey(seed ^ gl_LocalInvocationIndex, gathered));
    }
    barrier();
    if (candidate != ~0u && (candidate & 63u) == gl_LocalInvocationIndex)
        spawnSurfel(p, gathered);
}
