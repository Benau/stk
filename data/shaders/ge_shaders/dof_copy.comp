// The whole image of GEVulkanDepthOfField is copied first if the viewports are
// not all of it: the stages of the final chain write all pixels
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D u_dst;

void main()
{
    const ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pos, textureSize(u_src, 0))))
        return;
    imageStore(u_dst, pos, texelFetch(u_src, pos, 0));
}
