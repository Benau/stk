// First pass of GEVulkanDepthOfField: the color of every 2x2 block of the
// viewport at half size, and the signed circle of confusion (coc) of the block
// in alpha. The pixels are weighted by their coc, so the pixels in focus
// don't give their color to the blurred area next to them (a sharp
// foreground never leaks into a blurred background), and the block of a
// silhouette has the color and the coc of the part which is blurred
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "utils/dof_common.glsl"

layout(set = 0, binding = 0) uniform sampler2D u_color;
layout(set = 2, binding = 1, rgba16f) uniform writeonly image2D u_half;

#include "utils/dof_depth.glsl"

void main()
{
    const ivec2 block = pc.m_half_rect.xy + ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(block, pc.m_half_rect.zw)))
        return;

    vec3 weighted = vec3(0.0);
    vec3 plain = vec3(0.0);
    float weight = 0.0;
    float coc_sum = 0.0;
    for (int i = 0; i < 4; i++)
    {
        const ivec2 pixel = block * 2 + ivec2(i & 1, i >> 1);
        const vec3 color = texelFetch(u_color, pixel, 0).rgb;
        const float coc = dofCoc(dofDistance(pixel));
        const float w = abs(coc);
        weighted += color * w;
        coc_sum += coc * w;
        weight += w;
        plain += color * 0.25;
    }
    // Everything in focus: the color is not used (the blend is 0 there)
    if (weight < 1.0e-4)
        imageStore(u_half, block, vec4(plain, 0.0));
    else
        imageStore(u_half, block, vec4(weighted / weight, coc_sum / weight));
}
