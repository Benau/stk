#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;
#include "utils/surfel_gi_apply.glsl"

layout(set = SURFEL_SET, binding = 13, rgba32ui) uniform writeonly uimage2D u_representatives;

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 pixel = pc.m_rect.xy + texel * 2;
    if (any(greaterThanEqual(pixel, pc.m_rect.zw)))
        return;
    SurfelPixel surface;
    bool visible = loadSurfelPixel(pixel, surface);
    vec4 gi = vec4(0.0);
    vec2 contact = vec2(0.0);
    if (visible)
    {
        SurfelGather gathered = gatherSurfels(surface);
        float coverage = clamp(gathered.m_weight_sum * 2.0, 0.0, 1.0);
        if (gathered.m_weight_sum > 0.0)
            gi = vec4(gathered.m_irradiance / gathered.m_weight_sum, coverage);
        contact = vec2(coverage, coverage * gathered.m_origin_distance_sum / max(gathered.m_weight_sum, 1e-6));
    }
    imageStore(u_representatives, texel, uvec4(packSurfelGIRGB(gi.rgb), packHalf2x16(contact), floatBitsToUint(gi.a), 0u));
}
