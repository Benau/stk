// Third pass of GEVulkanSurfelGI (see utils/surfel_gi.glsl), one thread per
// surfel of the pool: SURFEL_RAYS cosine weighted rays from the surfel, traced
// in the static scene only (RT_MASK_STATIC). A hit is lit like the hit of a ray
// traced reflection (shadeHit of utils/rt_reflection.glsl: the sun with a
// shadow ray of the static scene and the ambient color, without the environment
// maps, see RT_HIT_NO_ENVIRONMENT), a ray which hits the back of a triangle is
// inside of a mesh and sees nothing, and a ray which hits nothing sees the
// skybox (the cosine weighted rays average it like the diffuse environment map
// does, so it doesn't need image based lighting). The mean of the rays is added
// to the running mean of the irradiance of the surfel.
//
// Only what doesn't move lights the surfels, so they can be cached: the static
// scene, the sun and the sky (the dynamic nodes are not in RT_MASK_STATIC, and
// shadeHit has no point light). With the frame cache, a surfel which converged
// only traces in one of SURFEL_CACHED_TRACE_PERIOD frames, and one which
// didn't traces more rays (SURFEL_YOUNG_RAY_SCALE) with as many threads: the
// surfels are the ones of the lists of surfel_gi_update.comp (u_trace_lists),
// the young ones and the converged ones whose turn it is in 2 dispatches.
//
// Set 0 is the one of GEVulkanRTScene, set 1 the camera and the global light
// (of the first viewport), set 2 the surfels, set 3 the mesh textures and set 4
// the environment
#extension GL_EXT_ray_query : require

layout(local_size_x = 64) in;

#define SURFEL_SET 2
#define MESH_TEXTURES_SET 3
#define RT_SHADOW_MASK RT_MASK_STATIC
#define RT_SHADOW_NO_FADE
// A hit isn't lit by the environment maps: they are the light of the whole
// sky, a wall of a tunnel or of the inside of a barn would get all of it
// (and its colour) as the bounce of the sky. The surfels get the sky from
// their rays which hit nothing (getSkyRadiance), so only the sky which they
// see lights them. The ambient color is kept, a ray which hits nothing has it
// too
#define RT_HIT_NO_ENVIRONMENT
// Without the environment maps a hit only has the sun and the ambient color
// (a grey of the track, not the sky), the inside of a tunnel or a barn is
// darker than with the unoccluded sky which it had before: the ambient color
// of a hit is brighter instead, it adds no sky light where there is none. A
// ray which hits nothing has the ambient color once, a hit has it times its
// albedo and this, so with an albedo up to 1 / RT_HIT_AMBIENT_SCALE a closed
// space is still not brighter than an open one
#define RT_HIT_AMBIENT_SCALE 3.0

layout(set = 4, binding = 0) uniform samplerCube u_diffuse;
layout(set = 4, binding = 1) uniform samplerCube u_specular;
// The sRGB view of the skybox (the env set of a deferred draw call), so it's
// linear
layout(set = 4, binding = 2) uniform samplerCube u_skybox;
// Only to share pbr_light.glsl, the shadow of a hit is a ray
layout(set = 4, binding = 3) uniform sampler2DArrayShadow u_shadow_map;

#include "utils/camera.glsl"
#include "utils/constants_utils.glsl"
#include "utils/pbr_utils.glsl"
#include "utils/get_vertex_color.glsl"
#include "utils/sample_mesh_texture.glsl"
#include "../utils/rgb_conversion.frag"
#include "utils/global_light_data.glsl"
#include "utils/pbr_light.glsl"
#include "utils/rt_utils.glsl"
#include "utils/rt_scene.glsl"
#include "utils/rt_reflection.glsl"
#include "utils/surfel_gi.glsl"

// The radiance of a ray which hits nothing, without a skybox it's the ambient
// which the lighting pass uses without image based lighting. Plus the ambient
// color which PBRSunAmbientEmitLight adds to every surface (the rest of the
// sky, which the lighting pass doesn't add where the surfels cover a pixel,
// see handlePBRDeferred): a hit has it too (shadeHit), so a surfel which sees
// the sky gets it like one which sees walls, otherwise a closed tunnel is
// brighter than the open valley around it at night (its rays hit walls lit by
// it, the ones in the valley see a black sky)
vec3 getSkyRadiance(vec3 direction)
{
    vec3 ambient = getAmbientColor(u_global_light.m_ambient_color);
    if (pc.m_has_skybox != 0u)
        return texture(u_skybox, direction).rgb + ambient;
    return getAmbientIrradiance() + ambient;
}

// back_face is set if the ray hits the back of a triangle
vec3 traceSurfelRay(vec3 origin, vec3 direction, inout bool back_face)
{
    rayQueryEXT ray_query;
    rayQueryInitializeEXT(ray_query, u_tlas, gl_RayFlagsNoneEXT,
        RT_MASK_STATIC, origin, RT_RAY_MIN, direction, RT_RAY_MAX);
    RT_PROCEED(ray_query)
    if (rayQueryGetIntersectionTypeEXT(ray_query, true) ==
        gl_RayQueryCommittedIntersectionNoneEXT)
        return getSkyRadiance(direction);
    if (!rayQueryGetIntersectionFrontFaceEXT(ray_query, true))
    {
        back_face = true;
        return vec3(0.0);
    }
    uint geometry_index =
        uint(rayQueryGetIntersectionInstanceCustomIndexEXT(ray_query, true)) +
        uint(rayQueryGetIntersectionGeometryIndexEXT(ray_query, true));
    return shadeHit(geometry_index,
        uint(rayQueryGetIntersectionPrimitiveIndexEXT(ray_query, true)),
        rayQueryGetIntersectionBarycentricsEXT(ray_query, true),
        rayQueryGetIntersectionTEXT(ray_query, true),
        mat3(rayQueryGetIntersectionWorldToObjectEXT(ray_query, true)),
        mat3(rayQueryGetIntersectionObjectToWorldEXT(ray_query, true)),
        origin, direction);
}

// With the frame cache, the rays of a surfel which didn't converge are traced
// by SURFEL_YOUNG_RAY_SCALE threads of the group (SURFEL_RAYS each): one
// thread would trace them one after the other, and there are only a few of
// these surfels in a frame (a few thousands), so the gpu would mostly wait for
// the rays. The sums of the rays of the threads and their back faces
shared vec4 s_young_rays[64];

// ----------------------------------------------------------------------------
// The radiance of count cosine weighted rays from the surfel (the seed is the
// one of the first of them), back_faces is how many hit the back of a triangle
vec3 traceSurfelRays(Surfel surfel, uint seed, uint count,
                     inout uint back_faces)
{
    vec3 normal = surfel.m_normal;
    vec3 tangent = normalize(abs(normal.y) < 0.999 ?
        cross(normal, vec3(0.0, 1.0, 0.0)) : cross(normal, vec3(1.0, 0.0, 0.0)));
    vec3 bitangent = cross(normal, tangent);
    vec3 origin = surfel.m_position + normal * RT_RAY_MIN;
    vec3 radiance = vec3(0.0);
    for (uint i = 0u; i < count; i++)
    {
        // Cosine weighted, so the mean of the radiance is the irradiance
        // divided by pi, the same as the diffuse environment map
        float u = getSurfelRandom(seed);
        float v = getSurfelRandom(seed);
        float r = sqrt(u);
        float phi = 6.28318530718 * v;
        vec3 direction = normalize(tangent * (r * cos(phi)) +
            bitangent * (r * sin(phi)) + normal * sqrt(max(1.0 - u, 0.0)));
        bool back_face = false;
        radiance += traceSurfelRay(origin, direction, back_face);
        if (back_face)
            back_faces++;
    }
    return radiance;
}   // traceSurfelRays

// ----------------------------------------------------------------------------
void main()
{
    uint index = gl_GlobalInvocationID.x;
    float steps = pc.m_steps;
    float max_samples = SURFEL_MAX_SAMPLES;
    uint ray_count = SURFEL_RAYS;
    // The thread of the rays of a surfel which didn't converge (the first one
    // sums them), see s_young_rays
    uint lane = 0u;
    bool young = false;
    uint id = index;
    bool has_surfel = true;
    if ((pc.m_cache & SURFEL_CACHE_FRAME) != 0u)
    {
        // The surfels of the list of this dispatch (see u_trace_lists)
        uint list = pc.m_trace_list;
        young = list == SURFEL_TRACE_YOUNG;
        if (young)
        {
            // A surfel which didn't converge yet traces
            // SURFEL_YOUNG_RAY_SCALE times the rays, as many samples: the
            // pixels around it are only in the history after it converged,
            // and a camera which moves keeps spawning new surfels, so they
            // converge in a quarter of the time (and their mean is less noisy
            // before)
            lane = index % SURFEL_YOUNG_RAY_SCALE;
            index /= SURFEL_YOUNG_RAY_SCALE;
            ray_count *= SURFEL_YOUNG_RAY_SCALE;
            steps *= float(SURFEL_YOUNG_RAY_SCALE);
        }
        else
        {
            // A converged surfel traces in one of the frames, its rays weigh
            // the steps of all of them, and its mean has more of them, so it
            // has as many rays as without the cache
            steps *= float(SURFEL_CACHED_TRACE_PERIOD);
            max_samples = SURFEL_CACHED_MAX_SAMPLES;
        }
        has_surfel = index < u_trace_lists.m_count[list];
        if (has_surfel)
            id = u_trace_lists.m_ids[list * pc.m_surfel_count + index];
    }
    else
        has_surfel = id < pc.m_surfel_count && u_surfels[id].m_radius != 0.0;

    Surfel surfel;
    vec3 radiance = vec3(0.0);
    uint back_faces = 0u;
    if (has_surfel)
    {
        surfel = u_surfels[id];
        // A different seed for every thread of a surfel
        uint seed = id * 9781u + pc.m_frame * 6271u + lane * 7919u;
        radiance = traceSurfelRays(surfel, seed, SURFEL_RAYS, back_faces);
    }
    // A surfel which didn't converge traces more rays than SURFEL_RAYS, which
    // a thread can't do in time: SURFEL_YOUNG_RAY_SCALE threads of the group
    // (in the same order as the surfels of the list) sum them, in uniform
    // control flow for the barrier
    if (young)
    {
        s_young_rays[gl_LocalInvocationIndex] =
            vec4(radiance, float(back_faces));
        barrier();
        if (lane != 0u)
            return;
        for (uint i = 1u; i < SURFEL_YOUNG_RAY_SCALE; i++)
        {
            vec4 rays = s_young_rays[gl_LocalInvocationIndex + i];
            radiance += rays.xyz;
            back_faces += uint(rays.w);
        }
    }
    if (!has_surfel)
        return;
    // Every ray is inside of a mesh, so is the surfel (it was spawned from a
    // camera inside of it, or the mesh is open): it's free again, a surfel
    // outside of it sees at least one ray out of it almost always
    if (back_faces == ray_count)
    {
        u_surfels[id].m_radius = 0.0;
        u_surfels[id].m_samples = 0.0;
        int at = atomicAdd(u_pool.m_free_count, 1);
        u_pool.m_free[at] = id;
        return;
    }
    radiance *= 1.0 / float(ray_count);
    // A few very bright hits (emissive, the sun on a glossy surface) would
    // stay in the mean for long
    float luminance = dot(radiance, vec3(0.2126, 0.7152, 0.0722));
    const float MAX_LUMINANCE = 8.0;
    if (luminance > MAX_LUMINANCE)
        radiance *= MAX_LUMINANCE / luminance;

    // The rays of this frame weigh its steps (pc.m_steps)
    float samples = min(surfel.m_samples + steps, max_samples);
    // A converged surfel which traces in one of the frames weighs its rays as
    // if it traced in all of them, not by its samples: they are only 64 when
    // it just converged, so a few rays would move its mean a lot (8 / 72 of
    // it) while the history of the frame cache reuses it
    float weight = steps / samples;
    if (max_samples == SURFEL_CACHED_MAX_SAMPLES)
        weight = steps / SURFEL_CACHED_MAX_SAMPLES;
    u_surfels[id].m_irradiance = mix(surfel.m_irradiance, radiance,
        min(weight, 1.0));
    u_surfels[id].m_samples = samples;
}
