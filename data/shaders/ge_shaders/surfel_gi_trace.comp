#extension GL_EXT_ray_query : require
layout(local_size_x = 64) in;
#include "utils/surfel_gi_transport.glsl"

vec3 cosineDirection(vec3 axis, float radius_squared, float angle)
{
    vec3 side = normalize(cross(axis, abs(axis.y) < 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0)));
    return sqrt(radius_squared) * (side * cos(angle) + cross(axis, side) * sin(angle)) +
        axis * sqrt(1.0 - radius_squared);
}

vec4 gameOfGoRule(vec3 origin, vec3 direction, float cell_size, uint target, float ray_weight)
{
    float limit = 4.0 * cell_size;
    vec4 result = surfelGISegment(origin, direction, limit, target, ray_weight);
    if (result.w == limit)
    {
        vec3 probe_position = origin + direction * (3.0 * cell_size);
        vec4 probe = lookupVolume(probe_position, direction, false);
        result.rgb = mix(result.rgb, probe.rgb, probe.a);
    }
    return result;
}

void main()
{
    uint list = pc.m_trace_list;
    uint threads = getSurfelTraceThreads(list);
    uint index = gl_GlobalInvocationID.x;
    uint entry = index / threads;
    if (entry >= u_trace_lists.m_selected[list])
        return;
    uint id = scheduledSurfel(list, entry);
    Surfel surfel = u_surfels[id];
    uint seed = id * 9781u;
    uint period = list == SURFEL_TRACE_CONVERGED && (pc.m_cache & SURFEL_CACHE_FRAME) != 0u ? SURFEL_CACHED_TRACE_PERIOD : 1u;
    float sequence = float((pc.m_frame / period) & 4095u);
    float radial_shift = fract(getSurfelRandom(seed) + sequence * 0.754877666);
    float rotation = fract(getSurfelRandom(seed) + sequence * 0.569840296);
    uint base = surfelRayBase(list) + index * SURFEL_RAYS_PER_THREAD;
    float spacing = intersectingClipSpacing(surfel.m_position, surfel.m_position);
    if (spacing == 0.0)
        spacing = getSurfelCellSize(getSurfelLevel(getSurfelCameraDistance(surfel.m_position)));
    vec3 origin = surfel.m_position + lighting[id].bias * surfel.m_normal;
    vec3 guide = unpackSnorm4x8(lighting[id].guide).xyz;
    uint count = threads * SURFEL_RAYS_PER_THREAD;
    uint guided = dot(guide, guide) > 0.25 ? count / 4u : 0u;
    float mixture = float(guided) / float(count);
    guide = guided > 0u ? normalize(guide) : surfel.m_normal;
    for (uint ray = 0u; ray < SURFEL_RAYS_PER_THREAD; ++ray)
    {
        uint sample_index = (index % threads) * SURFEL_RAYS_PER_THREAD + ray;
        bool use_guide = sample_index < guided;
        uint stratum = use_guide ? sample_index : sample_index - guided;
        float radius = (float(stratum) + radial_shift) / float(use_guide ? guided : count - guided);
        float turn = fract(rotation + float(sample_index) * 0.618033989);
        vec3 direction = cosineDirection(use_guide ? guide : surfel.m_normal, radius, 6.283185307 * turn);
        float cosine = dot(direction, surfel.m_normal);
        if (cosine <= 0.0)
        {
            ray_results[base + ray] = vec4(0.0);
            continue;
        }
        float pdf_ratio = cosine / mix(cosine, max(dot(direction, guide), 0.0), mixture);
        vec4 result = gameOfGoRule(origin, direction, spacing, base + ray, pdf_ratio);
        ray_results[base + ray] = vec4(result.rgb * pdf_ratio, result.w);
    }
}
