<?xml version="1.0" encoding="UTF-8"?>
<stkgui>
    <div x="2%" y="2%" width="96%" height="96%" layout="vertical-row" >
        <header id="title" width="100%" height="fit" text_align="center" word_wrap="true" text="Ray Tracing Settings" I18N="Ray tracing settings" />

        <spacer height="20" width="10" />

        <div layout="horizontal-row" width="100%" proportion="1">
            <checkbox id="rt_enabled"/>
            <spacer width="10" height="10"/>
            <label text="Ray tracing" I18N="Ray tracing settings"/>
        </div>

        <spacer height="4" width="10" />

        <div layout="horizontal-row" width="100%" proportion="1">
            <spacer width="70" height="10"/>
            <checkbox id="rt_reflection"/>
            <spacer width="10" height="10"/>
            <label text="Realistic reflections" I18N="Ray tracing settings"/>
        </div>

        <spacer height="4" width="10" />

        <div layout="horizontal-row" width="100%" proportion="1">
            <spacer width="70" height="10"/>
            <checkbox id="rt_dynamic_objects"/>
            <spacer width="10" height="10"/>
            <label text="Reflect karts and items" I18N="Ray tracing settings"/>
        </div>

        <spacer height="4" width="10" />

        <div layout="horizontal-row" width="100%" proportion="1">
            <spacer width="70" height="10"/>
            <checkbox id="rt_foliage"/>
            <spacer width="10" height="10"/>
            <label text="Reflect plants and fences" I18N="Ray tracing settings"/>
        </div>

        <spacer height="10" width="10" />

        <label id="rt_unsupported" width="100%" height="fit" word_wrap="true" text_align="center"
            text="Ray tracing needs advanced pipeline and a compatible device."
            I18N="Ray tracing settings"/>

        <spacer height="10" width="10"/>

        <buttonbar id="buttons" height="23%" width="40%" align="center">
            <icon-button id="cancel" width="128" height="128" icon="gui/icons/red_x.png"
                I18N="Ray tracing settings" text="Cancel" align="center"/>
            <icon-button id="apply" width="128" height="128" icon="gui/icons/green_check.png"
                I18N="Ray tracing settings" text="Apply" align="center"/>
        </buttonbar>
    </div>
</stkgui>
